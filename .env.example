# ==============================================================================
# JOBSTREAM - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   Bash: cp .env.example .env.local
#   PowerShell: Copy-Item .env.example .env.local
#
# DO NOT commit .env or .env.local to version control!
# ==============================================================================

# Database Connection (Prisma ORM)
# Local SQLite (default zero-config):
DATABASE_URL="file:./dev.db"
# Production PostgreSQL (Supabase, Neon, AWS RDS, etc.):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?sslmode=require"

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"

# ------------------------------------------------------------------------------
# Optional AI Provider Configurations
# ------------------------------------------------------------------------------
# The system runs an autonomous native heuristic NLP engine by default.
# Supply one of the keys below if you wish to activate external LLM enrichment:
# AI_API_KEY=""
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""